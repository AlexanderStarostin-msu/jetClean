#!/bin/sh

cd ${0%/*} || exit 1    # Run from this directory

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

runApplication blockMesh

echo "Running checkMesh ..."
checkMesh > log.checkMesh 2>&1

if ! grep -q "Mesh OK" log.checkMesh
then
    echo ""
    echo "ERROR: checkMesh failed"
    echo "======================"
    cat log.checkMesh
    exit 1
fi

echo "Mesh OK"

runApplication setFields

# runApplication decomposePar
# runParallel $(getApplication)
# runApplication reconstructPar

runApplication $(getApplication)

# case visualization
../../../utils/plotContours.py --field particles --iso 0.05 --dir ./postProcessing/midXYPlane
../../../utils/plotStreamlines.py U.air
../../../utils/plotStreamlines.py U.particles
gnuplot -c cropResidualsTotal save
gnuplot -c cropAlphaVol save

#combine in the dashboard
../../../utils/caseDash.py
rm residualsTotal.png Uair.png Uparticles.png particles_contour.png solidsVolTotal.png


