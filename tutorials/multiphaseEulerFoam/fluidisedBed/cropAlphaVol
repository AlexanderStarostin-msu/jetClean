#use with the command in the OF case folder:
#    gnuplot -c cropResidualsTotal save

if ( ARG1 eq "save") {
  set term png             
  set output "solidsVolTotal.png" 
}

set grid
set title system("echo  ${PWD##*/}: Residuals")
set ylabel "Solids volume m3"
set xlabel "Iteration"
#set yrange [1e-9:1];

solver="multiphaseEulerFoam"

labelTime = system( "tail -1000 log.".solver." | grep '^Time = ' | tail -1" )
set label 1 "".labelTime at 0,1.5 

labelCo = system( "tail -1000 log.".solver." | grep '^Courant Number mean: ' | tail -1")
set label 2 "".labelCo at 0,1.5-1 

#  volIntegrate() of alpha.particles = 0.000101716

cropFile=" cat log.".solver
plot "< ".cropFile." | grep 'volIntegrate() of alpha.particles' | tr -s ' ' | cut -d' ' -f6 | tr -d ','" title "solidsVolume" with lines,\

if ( ARG1 eq "save") {
  exit
}

pause 1

reread