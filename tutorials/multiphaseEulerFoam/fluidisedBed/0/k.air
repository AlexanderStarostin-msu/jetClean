FoamFile
{
    format      ascii;
    class       volScalarField;
    object      k.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [0 2 -2 0 0 0 0];

internalField       uniform 1;

boundaryField
{
    // Updated by bndFromMap.py at 2026-11-07T18:15:33Z (UTC)
    inlet
    {
        type fixedValue; value $internalField;
    }

    outlet
    {
        type inletOutlet; phi phi.air; inletValue $internalField; value $internalField;
    }

    walls
    {
        type kqRWallFunction; value $internalField;
    }

    frontAndBackPlanes
    {
        type empty;
    }

    annularSlit
    {
        type inletOutlet; phi phi.air; inletValue $internalField; value $internalField;
    }

    centerSlit
    {
        type inletOutlet; phi phi.air; inletValue $internalField; value $internalField;
    }

    tubungSlit
    {
        type inletOutlet; phi phi.air; inletValue $internalField; value $internalField;
    }

    tubingSlit
    {
        type inletOutlet; phi phi.air; inletValue $internalField; value $internalField;
    }
}

// ************************************************************************* //
