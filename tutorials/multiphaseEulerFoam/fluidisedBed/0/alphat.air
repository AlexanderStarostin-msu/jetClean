FoamFile
{
    format      ascii;
    class       volScalarField;
    object      alphat.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // Updated by bndFromMap.py at 2026-11-08T17:31:48Z (UTC)
    inlet
    {
        type calculated; value $internalField;
    }

    outlet
    {
        type calculated; value $internalField;
    }

    walls
    {
        type compressible::alphatWallFunction; Prt 0.85; value $internalField;
    }

    defaultFaces
    {
        type empty;
    }

    annularSlit
    {
        type calculated; value $internalField;
    }

    centerSlit
    {
        type compressible::alphatWallFunction; Prt 0.85; value $internalField;
    }

    tubingSlit
    {
        type calculated; value $internalField;
    }
}

// ************************************************************************* //
