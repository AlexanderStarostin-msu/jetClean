FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      pMean;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 100000;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 100000;
    }
    outlet
    {
        type            calculated;
        value           uniform 100000;
    }
    walls
    {
        type            calculated;
        value           uniform 100000;
    }
    frontAndBackPlanes
    {
        type            empty;
    }
}


