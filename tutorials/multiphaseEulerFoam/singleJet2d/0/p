FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [1 -1 -2 0 0 0 0];

internalField       uniform 1e7;

boundaryField
{
    // Updated by bndFromMap.py at 2026-11-08T23:58:51Z (UTC)
    centerSlit
    {
        type calculated; value $internalField;
    }
    tubingSlit
    {
        type calculated; value $internalField;
    }
    annularSlit
    {
        type calculated; value $internalField;
    }

    inlet
    {
        type            calculated;
        value           $internalField;
    }

    outlet
    {
        type            calculated;
        value           $internalField;
    }

    walls
    {
        type            calculated;
        value           $internalField;
    }

    frontAndBackPlanes
    {
        type            empty;
    }


    defaultFaces
    {
        type calculated; value $internalField;
    }
}

