FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [1 -1 -2 0 0 0 0];

internalField       uniform 1e5;

boundaryField
{
    // Updated by bndFromMap.py at 2026-11-08T17:31:48Z (UTC)
    inlet
    {
        type fixedFluxPressure; value $internalField;
    }

    outlet
    {
        type prghPressure; p $internalField; value $internalField;
    }

    walls
    {
        type fixedFluxPressure; value $internalField;
    }

    frontAndBackPlanes
    {
        type empty;
    }

    annularSlit
    {
        type fixedFluxPressure; value $internalField;
    }

    centerSlit
    {
        type fixedFluxPressure; value $internalField;
    }

    tubingSlit
    {
        type prghPressure; p $internalField; value $internalField;
    }
}

