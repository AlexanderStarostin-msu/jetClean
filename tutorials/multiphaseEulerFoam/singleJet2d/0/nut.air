FoamFile
{
    format      ascii;
    class       volScalarField;
    object      nut.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [0 2 -1 0 0 0 0];

internalField       uniform 0;

boundaryField
{
    // Updated by bndFromMap.py at 2026-11-08T23:12:34Z (UTC)
    inlet
    {
        type calculated; value $internalField;
    }

    outlet
    {
        type calculated; value $internalField;
    }

    walls
    {
        type nutkWallFunction; value $internalField;
    }

    frontAndBackPlanes
    {
        type empty;
    }

    annularSlit
    {
        type calculated; value $internalField;
    }

    centerSlit
    {
        type nutkWallFunction; value $internalField;
    }

    tubingSlit
    {
        type calculated; value $internalField;
    }

}

// ************************************************************************* //
