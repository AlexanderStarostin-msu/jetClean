FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [0 0 0 1 0 0 0];

internalField       uniform 600;

boundaryField
{
    // Updated by bndFromMap.py at 2026-11-08T17:31:48Z (UTC)
    inlet
    {
        type fixedValue; value uniform 300;
    }

    outlet
    {
        type inletOutlet; phi phi.air; inletValue uniform 300; value uniform 300;
    }

    walls
    {
        type zeroGradient;
    }

    frontAndBackPlanes
    {
        type empty;
    }

    annularSlit
    {
        type fixedValue; value uniform 300;
    }

    centerSlit
    {
        type zeroGradient;
    }

    tubingSlit
    {
        type zeroGradient;
    }
}

// ************************************************************************* //
