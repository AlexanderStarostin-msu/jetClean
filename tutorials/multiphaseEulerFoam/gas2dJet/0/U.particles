FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U.particles;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // Updated by bndFromMap.py at 2026-11-08T23:12:34Z (UTC)
    inlet
    {
        type fixedValue; value uniform (0 0 0);
    }

    outlet
    {
        type fixedValue; value uniform (0 0 0);
    }

    walls
    {
        type slip;
    }

    frontAndBackPlanes
    {
        type empty;
    }

    annularSlit
    {
        type pressureInletOutletVelocity; phi phi.particles; value $internalField;
    }

    centerSlit
    {
        type slip;
    }

    tubingSlit
    {
        type fixedValue; value uniform (0 0 0);
    }
}

// ************************************************************************* //
