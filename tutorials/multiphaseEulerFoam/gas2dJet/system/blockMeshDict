FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "./constant/inputParameters"

convertToMeters 1;

vertices
(
    // Front plane (z = -0.01) - 4 partitions along X ($xmin, $x1, $x2, $xmax)
    ($xmin $ymin -0.01) // 0
    ($x1   $ymin -0.01) // 1
    ($x2   $ymin -0.01) // 2
    ($xmax $ymin -0.01) // 3
    ($xmax $ymax -0.01) // 4
    ($x2   $ymax -0.01) // 5
    ($x1   $ymax -0.01) // 6
    ($xmin $ymax -0.01) // 7

    // Back plane (z = 0.01)
    ($xmin $ymin 0.01)  // 8
    ($x1   $ymin 0.01)  // 9
    ($x2   $ymin 0.01)  // 10
    ($xmax $ymin 0.01)  // 11
    ($xmax $ymax 0.01)  // 12
    ($x2   $ymax 0.01)  // 13
    ($x1   $ymax 0.01)  // 14
    ($xmin $ymax 0.01)  // 15
);

blocks
(
    // Block 1: Center region ($xmin to $x1)
    hex (0 1 6 7 8 9 14 15) (16 80 1) simpleGrading (1 1 1)

    // Block 2: Tubing region ($x1 to $x2)
    hex (1 2 5 6 9 10 13 14) (4 80 1) simpleGrading (1 1 1)

    // Block 3: Annular region ($x2 to $xmax)
    hex (2 3 4 5 10 11 12 13) (10 80 1) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
        );
    }

    centerSlit
    {
        type wall; // No flow region at y = ymax
        faces
        (
        );
    }

    tubingSlit
    {
        type patch; // Fluid flow region at y = ymax
        faces
        (
            (6 13 14 5) // Top face of Block 2 (at y = ymax)
        );
    }

    annularSlit
    {
        type patch; // Open outlet region at y = ymax
        faces
        (
            (5 12 13 4) // Top face of Block 3 (at y = ymax)
        );
    }

    walls
    {
        type wall;
        faces
        (
            (0 7 15 8)  // X-min outer wall (Block 1)
            (3 11 12 4) // X-max outer wall (Block 3)

           //from inlet
            (0 9 8 1)   // Y-min face of Block 1
            (1 10 9 2)  // Y-min face of Block 2
            (2 11 10 3) // Y-min face of Block 3

           //from centerSlit
            (7 14 15 6) // Top face of Block 1 (at y = ymax)
        );
    }

    frontAndBackPlanes
    {
        type empty;
        faces
        (
            // Front plane (z = -0.01) for all 3 blocks
            (0 1 6 7)
            (1 2 5 6)
            (2 3 4 5)
            // Back plane (z = 0.01) for all 3 blocks
            (8 15 14 9)
            (9 14 13 10)
            (10 13 12 11)
        );
    }
);